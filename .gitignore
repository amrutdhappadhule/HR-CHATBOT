
# Secrets and environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo

# Testing, linting and type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and editor files
.vscode/
.idea/

# Uploaded documents and runtime data
data/uploads/*
!data/uploads/.gitkeep

# Local FAISS index and metadata
vector_db/*
!vector_db/.gitkeep

# Logs and temporary files
*.log
*.tmp

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Archives and large media files
*.zip
*.7z
*.mp4
*.mov
*.avi
*.mkv
*.webm


# Project reference documents
project-story/